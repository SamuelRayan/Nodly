# Copy to mobile/.env. EXPO_PUBLIC_* values are built into the JavaScript bundle: never put
# secrets here. Metro reads this file when you run `npm start`.

# The Nodly API as the phone sees it (see docs/SETUP.md, "Reaching the local backend"):
#   Android emulator:              http://10.0.2.2:8000
#   USB phone with adb reverse:    http://localhost:8000
#   Phone on the same Wi-Fi:       http://<this PC's LAN IP>:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Supabase project (Dashboard > Project Settings > API Keys). The publishable key is safe for apps.
EXPO_PUBLIC_SUPABASE_URL=https://hlfxdejxdbukuyekqrjc.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Which store this build targets: galaxy | play | ios. EAS build profiles set it (eas.json).
EXPO_PUBLIC_STORE=galaxy

# EAS project id (from `npx eas-cli@latest init`); needed for Expo push tokens.
EAS_PROJECT_ID=
