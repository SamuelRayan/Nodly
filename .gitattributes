# Normalise line endings in the repo; Windows checkouts still work because editors handle LF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.m4a binary
*.ttf binary
*.otf binary
*.jar binary
