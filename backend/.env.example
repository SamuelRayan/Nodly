# Nodly backend settings. Copy to backend/.env and adjust.
# Real environment variables override this file. Never commit .env.

# ---------------------------------------------------------------- environment
# One of: dev | test | staging | prod. Required, no default.
# dev   -> mounts the /dev/* helper routes (create families/users/elders, enqueue jobs).
# prod  -> hides /docs and /openapi.json.
ENV=dev

# ---------------------------------------------------------------- database
# Async SQLAlchemy URL (asyncpg driver). Local Postgres in dev; Supabase-hosted in staging/prod.
DATABASE_URL=postgresql+asyncpg://nodly:nodly@localhost:5432/nodly_dev
# Used only by pytest. The database name MUST end in _test: the suite drops and rebuilds it.
TEST_DATABASE_URL=postgresql+asyncpg://nodly:nodly@localhost:5432/nodly_test
# Connection pool per process (API and worker each have their own).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# true -> log every SQL statement (noisy; for debugging only).
DB_ECHO=false

# ---------------------------------------------------------------- logging
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json    -> one JSON object per line (default; use this outside your own terminal)
# console -> human-readable lines for local development
LOG_FORMAT=json

# ---------------------------------------------------------------- health
# How long GET /readyz waits for the database before answering 503.
READINESS_DB_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------- worker (python -m nodly.worker)
# How often an idle worker checks the jobs table for due work.
WORKER_POLL_INTERVAL_SECONDS=1
# Jobs one worker process runs at the same time.
WORKER_CONCURRENCY=4
# On Ctrl+C, how long to wait for running jobs to finish before exiting.
WORKER_SHUTDOWN_GRACE_SECONDS=30

# ---------------------------------------------------------------- job queue
# Attempts before a failing job moves to the dead-letter state (status=dead).
JOB_DEFAULT_MAX_ATTEMPTS=5
# Retry delay = min(BASE * 2^(attempt-1), MAX) plus up to 10% random jitter.
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_MAX_SECONDS=3600
# A handler running longer than this is cancelled and counts as a failed attempt.
JOB_TIMEOUT_SECONDS=300
# A job left "running" this long (e.g. its worker crashed) is reclaimed as a failed attempt.
# Must be greater than JOB_TIMEOUT_SECONDS.
JOB_LOCK_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------- Supabase Auth
# Project URL (Dashboard > Project Settings > API). Without it, user endpoints answer 503
# auth_not_configured. Required in staging/prod. The project must use asymmetric JWT signing
# keys (ES256/RS256): we verify tokens against {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://your-project-ref.supabase.co
# Expected "aud" claim of user access tokens.
SUPABASE_JWT_AUDIENCE=authenticated
# Publishable key (sb_publishable_...). Safe for clients; used only by scripts/dev_login.py.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# How long fetched signing keys are trusted, and the minimum gap between early refreshes
# when a token names a key we haven't seen (Supabase key rotation).
JWKS_CACHE_SECONDS=600
JWKS_MIN_REFRESH_INTERVAL_SECONDS=30
# Clock skew allowed when checking exp/iat.
JWT_LEEWAY_SECONDS=30

# ---------------------------------------------------------------- invites & pairing
# HMAC key for invite and pairing codes. At least 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Values starting with "dev-only-" are refused in staging/prod. Changing it voids open codes.
CODE_HASH_SECRET=dev-only-replace-me-with-a-long-random-string-0123456789
# Lifetimes of member invites and elder pairing codes.
INVITE_TTL_HOURS=48
PAIRING_CODE_TTL_MINUTES=15
# Invite links and pairing QR payloads are these prefixes + the code.
INVITE_LINK_BASE_URL=nodly://invite/
PAIRING_QR_BASE_URL=nodly://pair/

# ---------------------------------------------------------------- brute-force protection
# Failed code attempts (pairing claim, invite preview/accept) allowed per window, counted per
# client IP, per signed-in user and across everyone. Over the limit -> 429 with Retry-After.
# Behind a proxy, run uvicorn with --proxy-headers --forwarded-allow-ips=<proxy ip> so the
# client IP is real.
THROTTLE_WINDOW_SECONDS=900
THROTTLE_MAX_FAILURES_PER_IP=10
THROTTLE_MAX_FAILURES_PER_USER=10
THROTTLE_MAX_FAILURES_GLOBAL=500
# Wrong family PINs allowed per elder phone per window (taking a phone out of elder mode).
THROTTLE_MAX_PIN_FAILURES_PER_DEVICE=5

# ---------------------------------------------------------------- elder devices
# After a device rotates its token, the old token keeps working this long (so a lost
# response can't lock the elder's phone out).
DEVICE_TOKEN_ROTATION_GRACE_SECONDS=600
# How often a device's last_seen_at is written (at most once per this many seconds).
DEVICE_LAST_SEEN_INTERVAL_SECONDS=300

# ---------------------------------------------------------------- push notifications
# expo: send through the Expo Push Service (the dev/demo default). record: keep messages in
# memory instead (offline dev; tests use it).
PUSH_PROVIDER=expo
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Only if "enhanced push security" is turned on for the Expo project (expo.dev > Credentials).
# EXPO_PUSH_ACCESS_TOKEN=

# ---------------------------------------------------------------- check-ins
# How often the worker's check-in engine looks for reminders and alerts to send.
CHECKIN_TICK_SECONDS=60
