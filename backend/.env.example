# Nodly backend settings. Copy to backend/.env and adjust.
# Real environment variables override this file. Never commit .env.

# ---------------------------------------------------------------- environment
# One of: dev | test | staging | prod. Required, no default.
# dev   -> mounts the /dev/* helper routes (create families/users/elders, enqueue jobs).
# prod  -> hides /docs and /openapi.json.
ENV=dev

# ---------------------------------------------------------------- database
# Async SQLAlchemy URL (asyncpg driver). Local Postgres in dev; Supabase-hosted in staging/prod.
DATABASE_URL=postgresql+asyncpg://nodly:nodly@localhost:5432/nodly_dev
# Used only by pytest. The database name MUST end in _test: the suite drops and rebuilds it.
TEST_DATABASE_URL=postgresql+asyncpg://nodly:nodly@localhost:5432/nodly_test
# Connection pool per process (API and worker each have their own).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# true -> log every SQL statement (noisy; for debugging only).
DB_ECHO=false

# ---------------------------------------------------------------- logging
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json    -> one JSON object per line (default; use this outside your own terminal)
# console -> human-readable lines for local development
LOG_FORMAT=json

# ---------------------------------------------------------------- health
# How long GET /readyz waits for the database before answering 503.
READINESS_DB_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------- worker (python -m nodly.worker)
# How often an idle worker checks the jobs table for due work.
WORKER_POLL_INTERVAL_SECONDS=1
# Jobs one worker process runs at the same time.
WORKER_CONCURRENCY=4
# On Ctrl+C, how long to wait for running jobs to finish before exiting.
WORKER_SHUTDOWN_GRACE_SECONDS=30

# ---------------------------------------------------------------- job queue
# Attempts before a failing job moves to the dead-letter state (status=dead).
JOB_DEFAULT_MAX_ATTEMPTS=5
# Retry delay = min(BASE * 2^(attempt-1), MAX) plus up to 10% random jitter.
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_MAX_SECONDS=3600
# A handler running longer than this is cancelled and counts as a failed attempt.
JOB_TIMEOUT_SECONDS=300
# A job left "running" this long (e.g. its worker crashed) is reclaimed as a failed attempt.
# Must be greater than JOB_TIMEOUT_SECONDS.
JOB_LOCK_TIMEOUT_SECONDS=900
